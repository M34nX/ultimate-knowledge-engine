{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/M34nX/ultimate-knowledge-engine/main/schemas/exercise.schema.json",
  "title": "UKE Exercise Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "content_type",
    "locale",
    "level",
    "status",
    "task",
    "domain"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "content_type": {
      "const": "exercise"
    },
    "locale": {
      "type": "string"
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "specialist"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "published",
        "outdated",
        "deprecated"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 10
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "solution": {
      "type": "string"
    },
    "assessment_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string",
      "minLength": 2
    }
  }
}

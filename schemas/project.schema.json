{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/M34nX/ultimate-knowledge-engine/main/schemas/project.schema.json",
  "title": "UKE Learning Project Metadata",
  "description": "Structured metadata for build-from-scratch learning projects and their locale variants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "content_type",
    "locale",
    "domain",
    "level",
    "status",
    "learning_objectives",
    "milestones"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "content_type": {
      "const": "project"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "level": {
      "enum": ["beginner", "intermediate", "advanced", "specialist"]
    },
    "status": {
      "enum": ["draft", "reviewed", "verified", "published", "outdated", "deprecated"]
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "translation_of": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
